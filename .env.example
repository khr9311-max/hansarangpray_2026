# 운영 저장소
PRAYER_STORAGE_BACKEND=supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# 서버 전용 Supabase 키. 기존 프로젝트에서는 SUPABASE_SERVICE_ROLE_KEY도 사용할 수 있습니다.
SUPABASE_SECRET_KEY=

# 시트에서 이전하거나 시트 저장소를 명시적으로 사용할 때 필요합니다.
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Apps Script 스크립트 속성 SHEETS_API_SECRET과 같은 32자 이상의 비밀키
GOOGLE_SHEETS_API_SECRET=

# /admin 접속 비밀번호
ADMIN_PASSWORD=

# 팀 드롭다운 목록 (쉼표 구분)
NEXT_PUBLIC_TEAMS=영등포쪽방촌팀,단비팀,통일선교팀,전도팀,운영팀,국장,교역자

# 선택: QR 주소를 고정할 때만 설정
# NEXT_PUBLIC_SITE_URL=https://hansarangpray-2026.vercel.app

# 기존 Supabase 프로젝트와 시트 내보내기 스크립트에서 사용할 수 있습니다.
# SUPABASE_SERVICE_ROLE_KEY=
