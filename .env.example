# 서버 전용 Apps Script 웹 앱 배포 URL (/exec). NEXT_PUBLIC_를 붙이지 마세요.
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec

# Apps Script 스크립트 속성 SHEETS_API_SECRET과 같은 32자 이상의 비밀키
GOOGLE_SHEETS_API_SECRET=

# /admin 접속 비밀번호
ADMIN_PASSWORD=

# 팀 드롭다운 목록 (쉼표 구분)
NEXT_PUBLIC_TEAMS=영등포쪽방촌팀,단비팀,통일선교팀,전도팀,운영팀,국장,교역자

# 선택: QR 주소를 고정할 때만 설정
# NEXT_PUBLIC_SITE_URL=https://hansarangpray-2026.vercel.app

# 기존 Supabase 데이터 이전 스크립트에서만 사용. 새 앱 실행에는 필요 없습니다.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
